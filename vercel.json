{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(version.json|lang-switcher.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/notice/:num(\\d+)", "destination": "/notice/page/:num", "permanent": false },
    { "source": "/notice/:num(\\d+)/", "destination": "/notice/page/:num", "permanent": false },
    { "source": "/site-complete/notice/:num(\\d+)", "destination": "/notice/page/:num", "permanent": false },
    { "source": "/site-complete/notice/:num(\\d+)/", "destination": "/notice/page/:num", "permanent": false },
    { "source": "/site-complete/:num(\\d+)", "destination": "/notice/page/:num", "permanent": false },
    { "source": "/site-complete/:num(\\d+)/", "destination": "/notice/page/:num", "permanent": false },
    { "source": "/site-complete/page/:num(\\d+)", "destination": "/notice/page/:num", "permanent": false },
    { "source": "/site-complete/page/:num(\\d+)/", "destination": "/notice/page/:num", "permanent": false },
    { "source": "/page/:num(\\d+)", "destination": "/notice/page/:num", "permanent": false },
    { "source": "/page/:num(\\d+)/", "destination": "/notice/page/:num", "permanent": false },
    { "source": "/site-complete/notice/page/:num(\\d+)", "destination": "/notice/page/:num", "permanent": false },
    { "source": "/site-complete/notice/page/:num(\\d+)/", "destination": "/notice/page/:num", "permanent": false },
    { "source": "/overview", "destination": "/aboutus/overview", "permanent": false },
    { "source": "/plan", "destination": "/aboutus/plan", "permanent": false },
    { "source": "/rule", "destination": "/aboutus/rule", "permanent": false },
    { "source": "/recruit", "destination": "/aboutus/recruit", "permanent": false },
    { "source": "/book", "destination": "/aboutus/book", "permanent": false },
    { "source": "/latestissue", "destination": "/aboutus/latestissue", "permanent": false },
    { "source": "/officialgoods", "destination": "/aboutus/officialgoods", "permanent": false },
    { "source": "/org", "destination": "/aboutus/org", "permanent": false },
    { "source": "/backnumber", "destination": "/aboutus/backnumber", "permanent": false },
    { "source": "/faq", "destination": "/begin/faq", "permanent": false },
    { "source": "/tool", "destination": "/begin/tool", "permanent": false },
    { "source": "/history", "destination": "/howto/history", "permanent": false },
    { "source": "/terminology", "destination": "/howto/terminology", "permanent": false },
    { "source": "/site-complete/chuoshinsa/overview", "destination": "/schedule/chuoshinsa/overview", "permanent": false },
    { "source": "/site-complete/chuoshinsa/overview.html", "destination": "/schedule/chuoshinsa/overview", "permanent": false },
    { "source": "/chuoshinsa/overview", "destination": "/schedule/chuoshinsa/overview", "permanent": false },
    { "source": "/chuoshinsa/overview.html", "destination": "/schedule/chuoshinsa/overview", "permanent": false },
    { "source": "/site-complete/taikai", "destination": "/schedule/taikai", "permanent": false },
    { "source": "/site-complete/chuoshinsa", "destination": "/schedule/chuoshinsa", "permanent": false },
    { "source": "/site-complete/association", "destination": "/schedule/association", "permanent": false },
    { "source": "/site-complete/region", "destination": "/schedule/region", "permanent": false },
    { "source": "/site-complete/documents", "destination": "/documents", "permanent": false }
  ],
  "rewrites": [
    { "source": "/map", "destination": "/map/index.html" },
    { "source": "/map/", "destination": "/map/index.html" },
    {
      "source": "/(aboutus|begin|howto|info|notice|notice-cat|schedule|taikai|chuoshinsa|category|association-area|region-area|improve|news|documents|movie|img|pdf)/:path*",
      "destination": "/site-complete/$1/:path*"
    }
  ]
}
